# Django
SECRET_KEY=your-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL - or use DATABASE_URL for production)
DB_NAME=debugduel
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# Use DATABASE_URL for production (Render provides this)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Frontend URLs for CORS
FRONTEND_URL=http://localhost:5173,http://localhost:8081

# Groq AI (for code judging)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Redis (for caching, Celery, WebSockets)
REDIS_URL=redis://localhost:6379/0

# Email (for notifications/password reset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
